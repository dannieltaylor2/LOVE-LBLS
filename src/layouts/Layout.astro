---
import '@fontsource-variable/inter';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/global.css';
interface Props {
  title?: string;
}
const { title = 'LOVE LABELS® — Ordinary can. Personal story.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href={import.meta.env.BASE_URL + 'images/products/silver-can.webp'}
      as="image"
      fetchpriority="high"
    />
    <meta name="theme-color" content="#050505" />
    <meta
      name="description"
      content="Personalized vinyl labels for 250 ml slim cans. Add a name, a photo, an inside joke. Turn their favorite drink into a gift made just for them."
    />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content="Same drink. Different story. Create a personalized vinyl label for someone you love."
    />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + 'favicon.svg'} />
    <title>{title}</title>
  </head>
  <body
    style={`--artwork-image:url('${import.meta.env.BASE_URL}images/products/label-artwork.webp');--metal-image:url('${import.meta.env.BASE_URL}images/products/silver-can.webp')`}
  >
    <slot />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
