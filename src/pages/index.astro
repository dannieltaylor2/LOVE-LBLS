---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import CollectionStory from '../components/CollectionStory.astro';
import LabelUnwrap from '../components/LabelUnwrap.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Personalizer from '../components/Personalizer.astro';
import RealStories from '../components/RealStories.astro';
import OccasionMenu from '../components/OccasionMenu.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Navigation />
  <main id="main" tabindex="-1">
    <Hero />
    <CollectionStory />
    <LabelUnwrap />
    <HowItWorks />
    <Personalizer />
    <RealStories />
    <OccasionMenu />
    <FinalCTA />
  </main>
  <Footer />
</Layout>
