---
import Can from './Can.astro';
import { designs } from '../data/site';
---

<div class="collection-story">
  <section
    id="designs"
    class="collection section-shell"
    aria-labelledby="collection-heading"
    data-chapter
  >
    <div class="section-kicker">
      <span class="eyebrow">01 / THE COLLECTION</span>
      <span class="eyebrow">SMALL OBJECT. PERSONAL MEANING.</span>
    </div>
    <div class="section-heading-row">
      <h2 id="collection-heading">
        ONE CAN.
        <br />
        <span class="muted">A THOUSAND</span>
        <br />
        <span class="muted">REASONS.</span>
      </h2>
      <div class="section-intro">
        <p>
          For the big milestones.
          <br />
          The little inside jokes.
          <br />
          And everything in between.
        </p>
        <a href="#occasions" class="text-link">
          FIND YOUR OCCASION{' '}
          <span>
            <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.4" />
            </svg>
          </span>
        </a>
      </div>
    </div>
    <div class="design-exhibition">
      {designs.map((d, i) => (
        <article
          class:list={['design-display', `design-display--${i + 1}`, { 'travel-origin': i === 0 }]}
        >
          <a
            href="#personalize"
            class="design-product-link"
            data-select-design={d.id}
            aria-label={`Personalize the ${d.name} design`}
          >
            <div class:list={['gallery-product', { traveler: i === 0 }]}>
              <Can design={d.id} />
            </div>
            <span class="view-design">
              VIEW DESIGN{' '}
              <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.4" />
              </svg>
            </span>
          </a>
          <div class="design-caption">
            <span class="eyebrow">{d.number}</span>
            <div>
              <h3>{d.name}</h3>
              <p>{d.description}</p>
            </div>
            <a
              href="#personalize"
              data-select-design={d.id}
              class="design-arrow"
              aria-label={`Choose ${d.name}`}
            >
              <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.4" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
    <div class="collection-foot">
      <span class="eyebrow">YOUR PEOPLE. YOUR WORDS. YOUR LABEL.</span>
      <a class="text-link" href="#personalize">
        MAKE ONE PERSONAL{' '}
        <span>
          <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.4" />
          </svg>
        </span>
      </a>
    </div>
  </section>
  <section
    id="about"
    class="product-story section-shell"
    aria-labelledby="story-heading"
    data-chapter
  >
    <div class="section-kicker">
      <span class="eyebrow">02 / THE LITTLE DIFFERENCE</span>
      <span class="eyebrow">DESIGNED TO MEAN MORE</span>
    </div>
    <div class="story-composition">
      <div class="story-copy">
        <h2 id="story-heading">
          NOT A NEW
          <br />
          DRINK.
          <br />
          <span class="muted">A NEW</span>
          <br />
          <span class="muted">STORY.</span>
        </h2>
        <p>
          Love Labels are custom-designed vinyl wraps made for standard 250 ml slim cans. The same
          drink, but made specifically for them.
        </p>
        <p class="product-disclaimer">We make the label. You bring their favorite drink.</p>
      </div>
      <div class="story-can-target">
        <Can design="birthday" class="story-fallback" />
        <div class="detail-loupe" aria-hidden="true">
          <svg viewBox="0 0 100 100">
            <rect width="100" height="100" fill="#c5acf2" />
            <path
              d="M50 18C12-8-5 40 29 51C-9 74 34 110 51 77C84 112 111 64 76 50C116 20 65-9 50 18Z"
              fill="#38244f"
            />
            <circle cx="52" cy="49" r="13" fill="#c5acf2" />
          </svg>
        </div>
        <span class="product-cross cross-top" aria-hidden="true">
          +
        </span>
        <span class="product-cross cross-bottom" aria-hidden="true">
          +
        </span>
      </div>
      <div class="product-callouts">
        <div class="callout">
          <span class="callout-number">01</span>
          <h3>PREMIUM VINYL</h3>
          <p>
            Durable, waterproof
            <br />
            and made to last.
          </p>
          <span class="material-or">OR</span>
          <h3>STICKER PAPER</h3>
          <p>Simple and cost-efficient.</p>
        </div>
        <div class="callout">
          <span class="callout-number">02</span>
          <h3>YOUR DESIGN</h3>
          <p>
            Your words. Your photo.
            <br />
            Their kind of gift.
          </p>
        </div>
        <div class="callout">
          <span class="callout-number">03</span>
          <h3>250 ML SLIM CANS</h3>
          <p>
            A wrap made for standard
            <br />
            European slim cans.
          </p>
        </div>
        <div class="callout">
          <span class="callout-number">04</span>
          <h3>EASY TO APPLY</h3>
          <p>
            Peel. Align. Smooth.
            <br />
            Ready to make someone smile.
          </p>
        </div>
        <p class="eyebrow gifting-note">DESIGNED FOR GIFTING.</p>
      </div>
    </div>
  </section>
</div>
