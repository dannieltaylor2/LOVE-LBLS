---
import { navigation } from '../data/site';
---

<a class="skip-link" href="#main">
  Skip to content
</a>
<header class="site-header" id="topbar">
  <a class="wordmark" href="#top" aria-label="Love Labels home">
    LOVE LABELS<sup>®</sup>
  </a>
  <nav class="desktop-nav" aria-label="Main navigation">
    {navigation.map((item) => (
      <a href={item.href}>{item.label}</a>
    ))}
  </nav>
  <div class="nav-actions">
    <a href="#personalize" class="nav-cta">
      CREATE YOUR LABEL{' '}
      <span aria-hidden="true">
        <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.4" />
        </svg>
      </span>
    </a>
    <button
      class="menu-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span>
      <span></span>
    </button>
  </div>
</header>
<dialog id="mobile-menu" class="menu-dialog" aria-label="Navigation menu">
  <div class="menu-top">
    <a class="wordmark" href="#top">
      LOVE LABELS<sup>®</sup>
    </a>
    <button class="icon-button menu-close" aria-label="Close menu">
      ×
    </button>
  </div>
  <nav aria-label="Expanded navigation">
    {navigation.map((item, i) => (
      <a href={item.href}>
        <span class="eyebrow">0{i + 1}</span>
        {item.label}
        <span aria-hidden="true">
          <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.4" />
          </svg>
        </span>
      </a>
    ))}
  </nav>
  <a href="#personalize" class="button button--light">
    CREATE YOUR LABEL{' '}
    <span>
      <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.4" />
      </svg>
    </span>
  </a>
  <p class="menu-note">Ordinary can. Personal story.</p>
</dialog>
<nav class="chapter-nav" aria-label="Page chapters">
  <a href="#top" class="active" aria-label="01 Introduction">
    <span>01</span>
    <i></i>
  </a>
  <a href="#designs" aria-label="02 Designs">
    <span>02</span>
    <i></i>
  </a>
  <a href="#about" aria-label="03 The label">
    <span>03</span>
    <i></i>
  </a>
  <a href="#how-it-works" aria-label="04 How it works">
    <span>04</span>
    <i></i>
  </a>
  <a href="#personalize" aria-label="05 Make it yours">
    <span>05</span>
    <i></i>
  </a>
</nav>
