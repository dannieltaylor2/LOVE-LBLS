---
import Can from './Can.astro';
import LabelArtwork from './LabelArtwork.astro';
---

<section class="unwrap-scroll" aria-labelledby="unwrap-heading">
  <div class="unwrap-stage section-shell">
    <div class="unwrap-heading">
      <p class="eyebrow">A CLOSER LOOK</p>
      <h2 id="unwrap-heading">
        SEE THE
        <br />
        <span class="muted">LABEL FLAT.</span>
      </h2>
    </div>
    <div class="unwrap-visual">
      <div class="unwrap-can">
        <Can design="birthday" />
      </div>
      <div class="unwrapped-label" style="--label-color:#c5acf2;--label-ink:#38244f">
        <div class="flat-art">
          <LabelArtwork
            design="birthday"
            name="CHRISTOPHER"
            age="18"
            message="A LITTLE SOMETHING. JUST FOR YOU."
          />
        </div>
        <div class="flat-art flat-art--back">
          <p class="eyebrow">A LITTLE SOMETHING.</p>
          <strong>
            JUST
            <br />
            FOR
            <br />
            YOU
            <span>
              <svg class="star-icon" viewBox="0 0 100 100" aria-hidden="true">
                <path
                  d="M50 0 61 32 85 15 68 39 100 50 68 61 85 85 61 68 50 100 39 68 15 85 32 61 0 50 32 39 15 15 39 32Z"
                  fill="currentColor"
                />
              </svg>
            </span>
          </strong>
          <p>
            There’s nobody quite like you.
            <br />
            And that’s worth celebrating.
          </p>
          <span class="eyebrow">LOVE LABELS®</span>
        </div>
        <span class="label-curl" aria-hidden="true"></span>
      </div>
    </div>
    <div class="unwrap-bottom">
      <p class="eyebrow unwrap-instruction">↓ SCROLL TO UNWRAP</p>
      <div>
        <h3>THIS IS THE PRODUCT.</h3>
        <p>
          One personalized vinyl label. A whole lot of meaning.
          <br />
          Can and drink not included.
        </p>
      </div>
      <span class="eyebrow">PEEL. WRAP. GIFT.</span>
    </div>
  </div>
</section>
