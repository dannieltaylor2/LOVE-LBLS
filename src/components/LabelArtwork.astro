---
interface Props {
  design?: string;
  name?: string;
  age?: string;
  message?: string;
  uid?: string;
}
const {
  design = 'birthday',
  name = 'CHRISTOPHER',
  age = '18',
  message = 'NOW YOU HAVE THE FREEDOM!',
} = Astro.props;
const artwork = ['birthday', 'name-day', 'friends', 'anniversary'];
---

<svg
  class="label-artwork"
  data-design={design}
  viewBox="0 0 400 700"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  {artwork.map((id, index) => (
    <g class={`art-${id}`}>
      <svg
        x="0"
        y="0"
        width="400"
        height="700"
        viewBox={`${index * 400} 0 400 700`}
        preserveAspectRatio="none"
        overflow="hidden"
      >
        <image
          data-print-artwork
          href={import.meta.env.BASE_URL + 'images/products/label-artwork.webp'}
          width="1600"
          height="700"
          preserveAspectRatio="none"
        />
      </svg>
      <rect
        x="0"
        y="560"
        width="400"
        height="140"
        fill="#000"
        opacity={id === 'birthday' ? '.2' : '.6'}
      />
    </g>
  ))}
  <rect x="22" y="618" width="120" height="3" fill="var(--label-color, #cbef62)" />
  <text
    class="label-name"
    data-label-name
    x="200"
    y="604"
    text-anchor="middle"
    font-size="36"
    font-weight="600"
    font-style="italic"
    fill="#fff"
  >
    {name}
  </text>
  <text
    class="label-age"
    data-label-age
    x="315"
    y="665"
    text-anchor="middle"
    font-size="72"
    font-weight="800"
    font-style="italic"
    fill="var(--label-color, #f20c95)"
  >
    {age}
  </text>
  <text
    class="label-message"
    data-label-message
    x="200"
    y="693"
    text-anchor="middle"
    font-size="11"
    font-weight="600"
    fill="#fff"
  >
    {message}
  </text>
  <image
    data-label-photo
    x="125"
    y="340"
    width="150"
    height="150"
    preserveAspectRatio="xMidYMid slice"
    style="display:none"
  />
</svg>
