---
import Can from './Can.astro';
---

<section class="final-cta section-shell" aria-labelledby="final-heading">
  <div class="section-kicker">
    <span class="eyebrow">07 / SOMEBODY COMES TO MIND.</span>
    <span class="eyebrow">DON’T THEY?</span>
  </div>
  <div class="final-composition">
    <div>
      <h2 id="final-heading">
        WHO WILL
        <br />
        YOU MAKE
        <br />
        <span class="muted">ONE FOR?</span>
      </h2>
      <div class="hero-actions">
        <a class="button button--light" href="#personalize">
          CREATE YOUR LABEL{' '}
          <span>
            <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.4" />
            </svg>
          </span>
        </a>
        <a class="text-link" href="#designs">
          BROWSE DESIGNS{' '}
          <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.4" />
          </svg>
        </a>
      </div>
    </div>
    <div class="final-product">
      <Can blank />
      <span class="eyebrow">
        A BLANK CAN.
        <br />A THOUSAND POSSIBILITIES.
      </span>
    </div>
  </div>
</section>
